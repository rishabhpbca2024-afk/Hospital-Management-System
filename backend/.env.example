PORT=5001

# Option 1: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hospital_management_system
# Set to 'true' if using a cloud MySQL provider that requires SSL (e.g. TiDB Cloud, Aiven):
DB_SSL=false

# Option 2: Full Connection String / URI (If your cloud provider gives a mysql:// URI)
# DATABASE_URL=mysql://user:password@host:port/database?ssl={"rejectUnauthorized":false}

JWT_SECRET=your_jwt_secret_key_here
